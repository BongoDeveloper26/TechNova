# Copia este fichero como .env y cambia las contraseñas.
# El .env no se sube a Git (está en .gitignore); esta plantilla sí.

# PostgreSQL (base de datos OLTP; el data warehouse technova_dw se crea solo)
POSTGRES_USER=technova
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_DB=technova
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@technova.com
PGADMIN_PASSWORD=cambia_esta_contraseña

# Metabase (http://localhost:3000): usuario que crea dashboard/crear_dashboard.py
METABASE_ADMIN_EMAIL=admin@technova.com
METABASE_ADMIN_PASSWORD=TechNova2025!
